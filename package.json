{
  "name": "mahak-platform",
  "version": "0.1.0",
  "private": true,
  "description": "MAHAK platform monorepo — web shell, api boundary, and shared contracts (R01)",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "install:all": "pnpm install",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\" --ignore-path .prettierignore",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:web": "pnpm --filter @mahak/web test",
    "test:api": "pnpm --filter @mahak/api test",
    "test:e2e": "pnpm --filter @mahak/web test:e2e",
    "dev": "pnpm --filter @mahak/web dev",
    "dev:api": "pnpm --filter @mahak/api dev",
    "py:compileall": "python -m compileall apps/api",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run py:compileall"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
